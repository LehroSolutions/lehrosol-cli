{
  "name": "@lehrosolutions/cli",
  "version": "3.2.0-beta.2",
  "description": "LehroSol CLI v3 — truly agentic engineering console: autonomous goal→plan→execute→verify→adapt missions with recovery, guided onboarding, Grok/local model profiles, task-graph supervision, safe marketplace, release integrity, MCP, and the HELIX TUI.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "lehrosol": "./bin/lehrosol.js",
    "lehr-sol": "./bin/lehrosol.js"
  },
  "main": "./src/core/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "beta"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "README.md",
    "RELEASING.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "scripts",
    "extensions",
    "packaging"
  ],
  "scripts": {
    "start": "node bin/lehrosol.js",
    "doctor": "node bin/lehrosol.js doctor",
    "mcp": "node bin/lehrosol.js mcp start",
    "gui": "node bin/lehrosol.js gui",
    "docs:build": "node docs/tools/build-docs.mjs",
    "test": "node scripts/run-tests.mjs",
    "check": "node scripts/check-syntax.mjs",
    "prepack": "npm run check && npm test && npm run docs:build",
    "tui": "node bin/lehrosol.js tui --mode advanced",
    "release:prepare": "node scripts/release.mjs dist",
    "completion:bash": "node bin/lehrosol.js completions bash"
  },
  "keywords": [
    "agentic",
    "cli",
    "mcp",
    "loop-engineering",
    "ralph-engineering",
    "orchestration",
    "harness-engineering",
    "ai-agent",
    "opensource",
    "apache",
    "production-ready",
    "tui",
    "local-models",
    "worktrees",
    "tool-calling",
    "agentic-missions",
    "autonomous"
  ],
  "author": "Lehro Solutions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LehroSolutions/lehrosol-cli.git"
  },
  "homepage": "https://github.com/LehroSolutions/lehrosol-cli#readme",
  "bugs": {
    "url": "https://github.com/LehroSolutions/lehrosol-cli/issues"
  },
  "dependencies": {},
  "devDependencies": {}
}
